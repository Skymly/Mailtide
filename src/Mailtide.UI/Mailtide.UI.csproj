  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailtide.Core\Mailtide.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
