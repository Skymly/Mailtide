<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mailtide.UI.EditAccountDialog"
             Width="448"
             MinHeight="240">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Name="CancelButton" Content="Cancel" Width="88" Click="OnCancelClick" />
      <Button Name="SaveButton" Content="Save" Width="88" Click="OnSaveClick" IsVisible="False" />
      <Button Name="ReauthorizeButton" Content="Reauthorize" Width="110" Click="OnReauthorizeClick" IsVisible="False" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Text="Edit Account" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Name="AccountKindLabel" Opacity="0.8" />

      <StackPanel Name="OAuthFields" IsVisible="False" Spacing="8">
        <TextBlock Name="OAuthSummary" TextWrapping="Wrap" />
        <TextBlock Text="Reauthorize replaces the OAuth Credential and keeps this Account's local Mailboxes and Messages."
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   FontSize="12" />
      </StackPanel>

      <StackPanel Name="PasswordFields" IsVisible="False" Spacing="8">
        <TextBox Name="DisplayNameBox" PlaceholderText="Display name" />
        <TextBox Name="EmailBox" PlaceholderText="Email address" />

        <StackPanel Name="QqSecretFields" IsVisible="False" Spacing="8">
          <TextBox Name="QqAuthCodeBox" PlaceholderText="Authorization code (leave blank to keep)" PasswordChar="*" />
        </StackPanel>

        <StackPanel Name="ManualServerFields" IsVisible="False" Spacing="8">
          <TextBox Name="ImapHostBox" PlaceholderText="IMAP host" />
          <TextBox Name="ImapPortBox" PlaceholderText="IMAP port" />
          <TextBox Name="SmtpHostBox" PlaceholderText="SMTP host" />
          <TextBox Name="SmtpPortBox" PlaceholderText="SMTP port" />
          <TextBox Name="PasswordBox" PlaceholderText="Password (leave blank to keep)" PasswordChar="*" />
        </StackPanel>
      </StackPanel>

      <TextBox Name="SignatureBox"
               PlaceholderText="Signature"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="72" />

      <TextBlock Name="FormError" TextWrapping="Wrap" Opacity="0.85" Foreground="IndianRed" />
    </StackPanel>
  </DockPanel>
</UserControl>
