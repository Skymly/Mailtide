<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Mailtide.Core"
             xmlns:local="using:Mailtide.UI"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Mailtide.UI.MailShellView">
  <DockPanel Margin="12">
    <Border Name="UpdateBanner"
            DockPanel.Dock="Top"
            IsVisible="False"
            Background="#E8F0FE"
            Padding="10,8"
            Margin="0,0,0,12"
            CornerRadius="4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Name="UpdateNowButton" Content="Update" Click="OnUpdateNowClick" />
          <Button Name="DismissUpdateButton" Content="Dismiss" Click="OnDismissUpdateClick" />
        </StackPanel>
        <TextBlock Name="UpdateBannerText"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Mailtide" FontSize="20" VerticalAlignment="Center" />
      <Button Name="UnifiedInboxButton" Content="Unified Inbox" Click="OnUnifiedInboxClick" />
      <Button Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
      <Button Name="SyncNowButton" Content="Sync Now" Click="OnSyncNowClick" />
      <Button Name="SendNowButton" Content="Send Now" Click="OnSendNowClick" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0" MinHeight="220">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Compose" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Name="SaveDraftButton" Content="Save Draft" Click="OnSaveDraftClick" />
          <Button Name="SendDraftButton" Content="Send" Click="OnSendDraftClick" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBox Name="ComposeToBox" PlaceholderText="To" />
          <TextBox Name="ComposeSubjectBox" PlaceholderText="Subject" />
          <TextBox Name="ComposeBodyBox" PlaceholderText="Body" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
          <TextBlock Text="Drafts" FontWeight="SemiBold" Margin="0,8,0,0" />
          <ListBox Name="DraftsList" MinHeight="60" MaxHeight="100">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:DraftInfo">
                <TextBlock Text="{Binding Subject}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>

      <DockPanel Grid.Column="1">
        <TextBlock DockPanel.Dock="Top" Text="Outbox" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Name="RetryOutboxButton" Content="Retry" Click="OnRetryOutboxClick" />
          <Button Name="DiscardOutboxButton" Content="Discard" Click="OnDiscardOutboxClick" />
        </StackPanel>
        <ListBox Name="OutboxList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:OutboxItemInfo">
              <StackPanel>
                <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding State}" Opacity="0.7" FontSize="12" />
                <TextBlock Text="{Binding ErrorMessage}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <Grid ColumnDefinitions="220,200,*,*" ColumnSpacing="12">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Accounts" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Name="AddAccountButton" Content="Add Account" Click="OnAddAccountClick" />
          <Button Name="RemoveAccountButton" Content="Remove" Click="OnRemoveAccountClick" />
        </StackPanel>
        <TextBlock Name="AccountActionStatus"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   FontSize="12" />
        <ListBox Name="AccountsList"
                 SelectionChanged="OnAccountSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:AccountStatusRow">
              <StackPanel>
                <TextBlock Text="{Binding Account.DisplayName}" />
                <TextBlock Text="{Binding Account.EmailAddress}" Opacity="0.7" FontSize="12" />
                <TextBlock Text="{Binding Status.State}" Opacity="0.7" FontSize="12" />
                <TextBlock Text="{Binding Status.ErrorMessage}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="1">
        <TextBlock DockPanel.Dock="Top" Text="Mailboxes" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox Name="MailboxesList"
                 SelectionChanged="OnMailboxSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:MailboxInfo">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock Name="MessagesHeader"
                   DockPanel.Dock="Top"
                   Text="Messages"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <ListBox Name="MessagesList"
                 SelectionChanged="OnMessageSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:MessageInfo">
              <StackPanel>
                <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FromAddress}" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="3">
        <TextBlock DockPanel.Dock="Top" Text="Message" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Name="BodyUnavailableText"
                   DockPanel.Dock="Top"
                   Text="Body unavailable"
                   IsVisible="False"
                   Opacity="0.75"
                   Margin="0,0,0,8" />
        <TextBox Name="MessageBodyBox"
                 DockPanel.Dock="Top"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="Attachments" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Name="AttachmentOpenErrorText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   FontSize="12"
                   Margin="0,0,0,8" />
        <Button Name="OpenAttachmentButton"
                DockPanel.Dock="Bottom"
                Content="Open Attachment"
                Margin="0,8,0,0"
                Click="OnOpenAttachmentClick" />
        <ListBox Name="AttachmentsList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:AttachmentInfo">
              <StackPanel>
                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ContentType}" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
