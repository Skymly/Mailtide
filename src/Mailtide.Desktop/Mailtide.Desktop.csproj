<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version / InformationalVersion are stamped by Nuke publish when shipping Releases. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>

  <!-- Bake public OAuth client IDs from publish -p: properties into assembly metadata.
       BakedOAuthEnvironment copies them into process env at startup when unset. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                       Condition="'$(MAILTIDE_GOOGLE_OAUTH_CLIENT_ID)' != ''">
      <_Parameter1>MAILTIDE_GOOGLE_OAUTH_CLIENT_ID</_Parameter1>
      <_Parameter2>$(MAILTIDE_GOOGLE_OAUTH_CLIENT_ID)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                       Condition="'$(MAILTIDE_MICROSOFT_OAUTH_CLIENT_ID)' != ''">
      <_Parameter1>MAILTIDE_MICROSOFT_OAUTH_CLIENT_ID</_Parameter1>
      <_Parameter2>$(MAILTIDE_MICROSOFT_OAUTH_CLIENT_ID)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailtide.Core\Mailtide.Core.csproj" />
    <ProjectReference Include="..\Mailtide.UI\Mailtide.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailtide.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>
</Project>
